<Window x:Class="NGPVP.Staff.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NG PVP STAFF PC CHECK" Width="1100" Height="720" Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border BorderBrush="{StaticResource Green}" BorderThickness="1" CornerRadius="18" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><Image Source="ngpvp_logo.png" Width="62" Height="62"/><StackPanel Grid.Column="1"><TextBlock Text="NG PVP" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Green}"/><TextBlock Text="STAFF • REMOTE PC CHECK" FontSize="14"/></StackPanel><TextBlock x:Name="StatusText" Grid.Column="2" Text="OFFLINE" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource Green}"/></Grid></Border>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,18"><TextBlock Text="CONNECTED PLAYERS" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="PlayerBox" Width="300" DisplayMemberPath="Player" SelectionChanged="PlayerBox_SelectionChanged" Margin="0,0,10,0"/><Button Content="REFRESH" Width="100" Click="Refresh_Click"/><Button x:Name="StartButton" Content="START PC CHECK" Width="160" Margin="10,0,0,0" Click="Start_Click" IsEnabled="False" Background="{StaticResource Green}" Foreground="Black"/></StackPanel>
<Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock x:Name="PlayerText" Text="PLAYER: —" FontSize="18"/><TextBlock x:Name="CountsText" Text="   CLEAN: 0   KNOWN: 0   SUSPICIOUS: 0   DETECTED: 0" FontSize="18" Foreground="{StaticResource Green}" Margin="20,0,0,0"/></StackPanel><ListView x:Name="ResultsList" Background="#09100B" Foreground="{StaticResource Text}"><ListView.View><GridView><GridViewColumn Header="SEVERITY" DisplayMemberBinding="{Binding Severity}" Width="110"/><GridViewColumn Header="CATEGORY" DisplayMemberBinding="{Binding Category}" Width="160"/><GridViewColumn Header="ITEM" DisplayMemberBinding="{Binding Title}" Width="250"/><GridViewColumn Header="DETAILS" DisplayMemberBinding="{Binding Details}" Width="420"/></GridView></ListView.View></ListView></DockPanel></Border></Grid></Window>
